# Copy to .env and fill in. .env is gitignored.
# These document the environment variables every service expects.
# TODO: adjust names to match what your app and compose file actually use.

POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# How the app addresses each backing service.
# TODO: these hostnames differ between Vagrant and Compose — think about it.
DB_HOST=
CACHE_HOST=
BROKER_HOST=

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
